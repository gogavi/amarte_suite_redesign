# Backend del concierge Martina (ChatBotAmarte)
VITE_AMARTE_CHATBOT_URL=https://chatbotamarte-production.up.railway.app

# Supabase — conexión del cliente (Project Settings → API)
# Copia Project URL y anon/public key desde el dashboard de Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Destinos de reserva del formulario
VITE_WHATSAPP_RESERVAS=573007416683

# Wompi: la llave pública y los secretos viven en las Edge Functions
# (`supabase secrets set`). No uses prefijo VITE_ ni pongas WOMPI_PRIVATE_KEY aquí.

# Google Tag Manager — contenedor web (tagmanager.google.com)
# Ejemplo: GTM-W5VQCDF5. Vacío = no carga tags. En producción define el ID real.
VITE_GTM_ID=
